<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/nav_dashboard">

    <fragment
        android:id="@+id/nav_dashboard"
        android:name="com.brijby77.ui.dashboard.DashboardFragment"
        android:label="Home Dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/nav_add_student"
        android:name="com.brijby77.ui.addstudent.AddStudentFragment"
        android:label="Add Student"
        tools:layout="@layout/fragment_add_student">
        <argument
            android:name="studentId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

    <fragment
        android:id="@+id/nav_student_list"
        android:name="com.brijby77.ui.studentlist.StudentListFragment"
        android:label="Student List"
        tools:layout="@layout/fragment_student_list">
        <argument
            android:name="studentId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

    <fragment
        android:id="@+id/nav_cl0_pass"
        android:name="com.brijby77.ui.cl0pass.Cl0PassFragment"
        android:label="CL 0 &amp; CL Pass"
        tools:layout="@layout/fragment_cl0_pass" />

    <fragment
        android:id="@+id/nav_export_import"
        android:name="com.brijby77.ui.exportimport.ExportImportFragment"
        android:label="Export / Import"
        tools:layout="@layout/fragment_export_import" />

    <fragment
        android:id="@+id/nav_mdm"
        android:name="com.brijby77.ui.mdm.MdmReportFragment"
        android:label="MDM Report"
        tools:layout="@layout/fragment_mdm_report" />

    <fragment
        android:id="@+id/nav_caste_report"
        android:name="com.brijby77.ui.castereport.CasteReportFragment"
        android:label="Caste Report"
        tools:layout="@layout/fragment_caste_report" />

    <fragment
        android:id="@+id/nav_trash"
        android:name="com.brijby77.ui.trash.TrashFragment"
        android:label="Trash"
        tools:layout="@layout/fragment_trash" />

    <fragment
        android:id="@+id/nav_selected_export"
        android:name="com.brijby77.ui.exportimport.SelectedExportFragment"
        android:label="Selected Export"
        tools:layout="@layout/fragment_selected_export" />

    <!-- Notes Module Destinations -->
    <fragment
        android:id="@+id/nav_notes"
        android:name="com.brijby77.ui.notes.NotesListFragment"
        android:label="मेरी सूचना"
        tools:layout="@layout/fragment_notes_list">
        <action
            android:id="@+id/action_notes_list_to_add_edit_note"
            app:destination="@id/nav_add_edit_note" />
        <action
            android:id="@+id/action_notes_list_to_note_detail"
            app:destination="@id/nav_note_detail" />
    </fragment>

    <fragment
        android:id="@+id/nav_add_edit_note"
        android:name="com.brijby77.ui.notes.AddEditNoteFragment"
        android:label="Add / Edit Note"
        tools:layout="@layout/fragment_add_edit_note">
        <argument
            android:name="noteId"
            app:argType="long"
            android:defaultValue="-1L" />
    </fragment>

    <fragment
        android:id="@+id/nav_note_detail"
        android:name="com.brijby77.ui.notes.NoteDetailFragment"
        android:label="Note Detail"
        tools:layout="@layout/fragment_note_detail">
        <argument
            android:name="noteId"
            app:argType="long"
            android:defaultValue="-1L" />
        <action
            android:id="@+id/action_note_detail_to_add_edit_note"
            app:destination="@id/nav_add_edit_note" />
    </fragment>

    <!-- Examination & Auto Result Management Module Destinations -->
    <fragment
        android:id="@+id/nav_exam_dashboard"
        android:name="com.brijby77.ui.exam.ExamDashboardFragment"
        android:label="Exam Dashboard"
        tools:layout="@layout/fragment_exam_dashboard" />

    <fragment
        android:id="@+id/nav_subject_management"
        android:name="com.brijby77.ui.exam.SubjectManagementFragment"
        android:label="Subject Management"
        tools:layout="@layout/fragment_subject_management" />

    <fragment
        android:id="@+id/nav_create_exam"
        android:name="com.brijby77.ui.exam.CreateExamFragment"
        android:label="Create Exam"
        tools:layout="@layout/fragment_create_exam" />

    <fragment
        android:id="@+id/nav_exam_list"
        android:name="com.brijby77.ui.exam.ExamListFragment"
        android:label="Exam List"
        tools:layout="@layout/fragment_exam_list" />

    <fragment
        android:id="@+id/nav_marks_entry"
        android:name="com.brijby77.ui.exam.MarksEntryFragment"
        android:label="Marks Entry"
        tools:layout="@layout/fragment_marks_entry" />

    <fragment
        android:id="@+id/nav_result"
        android:name="com.brijby77.ui.exam.ResultFragment"
        android:label="Exam Results"
        tools:layout="@layout/fragment_result" />

    <fragment
        android:id="@+id/nav_report_card"
        android:name="com.brijby77.ui.exam.ReportCardFragment"
        android:label="Report Card"
        tools:layout="@layout/fragment_report_card" />

    <fragment
        android:id="@+id/nav_class_result"
        android:name="com.brijby77.ui.exam.ClassResultFragment"
        android:label="Class Result &amp; Ranks"
        tools:layout="@layout/fragment_class_result" />

    <fragment
        android:id="@+id/nav_subject_result"
        android:name="com.brijby77.ui.exam.SubjectResultFragment"
        android:label="Subject Result Analysis"
        tools:layout="@layout/fragment_subject_result" />

    <fragment
        android:id="@+id/nav_result_summary"
        android:name="com.brijby77.ui.exam.ResultSummaryFragment"
        android:label="Result Summary"
        tools:layout="@layout/fragment_result_summary" />

    <fragment
        android:id="@+id/nav_exam_settings"
        android:name="com.brijby77.ui.exam.ExamSettingsFragment"
        android:label="Exam Settings"
        tools:layout="@layout/fragment_exam_settings" />

    <fragment
        android:id="@+id/nav_full_report"
        android:name="com.brijby77.ui.exam.FullReportFragment"
        android:label="Full Report Marksheets"
        tools:layout="@layout/fragment_full_report" />

    <fragment
        android:id="@+id/nav_essential_links"
        android:name="com.brijby77.ui.links.EssentialLinksFragment"
        android:label="@string/essential_links_title"
        tools:layout="@layout/fragment_essential_links" />

    <fragment
        android:id="@+id/nav_tc_print"
        android:name="com.brijby77.ui.tc.TcPrintFragment"
        android:label="@string/tc_print_title"
        tools:layout="@layout/fragment_tc_print" />

    <fragment
        android:id="@+id/nav_tc_print2"
        android:name="com.brijby77.ui.tc.TcPrint2Fragment"
        android:label="TC Print 2"
        tools:layout="@layout/fragment_tc_print2" />

    <fragment
        android:id="@+id/nav_so2"
        android:name="com.brijby77.ui.so2.So2Fragment"
        android:label="Form S02 / UDISE"
        tools:layout="@layout/fragment_so2" />

    <fragment
        android:id="@+id/nav_so3"
        android:name="com.brijby77.ui.so3.So3Fragment"
        android:label="Form S03 / UDISE"
        tools:layout="@layout/fragment_so3" />

    <fragment
        android:id="@+id/nav_furniture"
        android:name="com.brijby77.ui.furniture.FurnitureFragment"
        android:label="फर्नीचर सूचना"
        tools:layout="@layout/fragment_furniture" />

    <fragment
        android:id="@+id/nav_profile"
        android:name="com.brijby77.ui.auth.ProfileFragment"
        android:label="User Profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profile_to_privacyPolicy"
            app:destination="@id/privacyPolicyFragment" />
        <action
            android:id="@+id/action_profile_to_terms"
            app:destination="@id/termsFragment" />
    </fragment>

    <fragment
        android:id="@+id/privacyPolicyFragment"
        android:name="com.brijby77.ui.auth.PrivacyPolicyFragment"
        android:label="Privacy Policy"
        tools:layout="@layout/fragment_privacy_policy" />

    <fragment
        android:id="@+id/termsFragment"
        android:name="com.brijby77.ui.auth.TermsFragment"
        android:label="Terms &amp; Conditions"
        tools:layout="@layout/fragment_terms" />

</navigation>

