<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E3A8A"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STUDENT REPORT CARD"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvReportSchoolHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SCHOOL EXAMINATION REPORT CARD"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1565C0"
                    android:gravity="center"
                    android:layout_marginBottom="8dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#CBD5E1"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvReportStudentInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Name: Loading...\nFather: -\nClass: - | SR: -"
                    android:textSize="13sp"
                    android:textColor="#1E293B"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvReportMarksSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Subject-wise marks loading..."
                    android:textSize="12sp"
                    android:textColor="#0F172A"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvReportFinalResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total: 0 / 0 (0.0%) | Grade: —"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#16A34A"
                    android:gravity="center" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnExportReportPdf"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="📥 Export PDF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#1565C0"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnPrintReport"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="🖨 Print"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:backgroundTint="#2E7D32" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
