<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER TITLE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E3A8A"
            android:gravity="center"
            android:padding="10dp"
            android:text="TRANSFER CERTIFICATE (TC) MODULE 2\nस्थानांतरण प्रमाण पत्र 2"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- 1. STUDENT SELECTION SECTION -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#CBD5E1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Search Type:"
                    android:textColor="#1E293B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <RadioGroup
                    android:id="@+id/rgSearchType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <RadioButton
                        android:id="@+id/rbName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Student Name"
                        android:textSize="13sp"
                        android:layout_marginEnd="24dp" />

                    <RadioButton
                        android:id="@+id/rbSrNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="SR Number"
                        android:textSize="13sp" />
                </RadioGroup>

                <!-- SEARCH BOX -->
                <EditText
                    android:id="@+id/etStudentSearch"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@android:drawable/editbox_background_normal"
                    android:hint="Search by Student Name..."
                    android:inputType="text"
                    android:autofillHints="name"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp" />

                <!-- LOADING INDICATOR -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

                <!-- NO STUDENT FOUND -->
                <TextView
                    android:id="@+id/tvNoStudentFound"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No Student Found"
                    android:textColor="#D32F2F"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:layout_gravity="center"
                    android:layout_marginBottom="8dp" />

                <!-- SEARCH RESULTS LIST (RECYCLERVIEW) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvStudentSearchResults"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:visibility="gone"
                    android:scrollbars="vertical" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. SELECTED STUDENT SUMMARY CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSelectedStudent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="#EFF6FF"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#3B82F6">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selected Student (Auto-Filled from Database):"
                    android:textColor="#1D4ED8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvSelectedStudentDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Name: - | SR: - | Class: -"
                    android:textColor="#0F172A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. EDITABLE TC-SPECIFIC FIELDS -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="10dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#CBD5E1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit TC-Specific Fields (Does not modify original student record):"
                    android:textColor="#1E293B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- TC Number -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTcNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="TC Certificate Number"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- UDISE Code -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUdiseCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="UDISE Code (यूडीएसई कोड)"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- School Name -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSchoolName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="School Name (विद्यालय का नाम)"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- School Address -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSchoolAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="School Address (पता)"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Tehsil -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTehsil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Tehsil (तहसील)"
                        android:text="सदर"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- District -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDistrict"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="District (जिला)"
                        android:text="उत्तर प्रदेश"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Duration of Stay in UP -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDurationOfStay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Duration of stay in UP (उत्तर प्रदेश में रहने की अवधि)"
                        android:text="पूर्ण अवधि"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Student Language -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStudentLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Student Language (विद्यार्थी की भाषा)"
                        android:text="हिन्दी (Hindi)"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Working Days -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etWorkingDays"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Total Working Days (स्कूल खुलने के दिन)"
                        android:text="220"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Attendance -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAttendance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Student Attendance (विद्यार्थी की उपस्थिति)"
                        android:text="205"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Father's Occupation -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFatherOccupation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Father Occupation (पिता का व्यवसाय)"
                        android:text="कृषि / सेवा"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Class Struck Off -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStruckOffClass"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Class Struck Off (तथा कक्षा जिसमें नाम कटा)"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Last Admission Date -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etLastAdmissionDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Last Admission Date (स्कूल में प्रवेश का अन्तिम दिनांक)"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Date of Leaving -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDateOfLeaving"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Date of Leaving (e.g. 31/03/2026)"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Reason for Leaving -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etReason"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Reason for Leaving (e.g. Completed Class 8 / Parents Transferred)"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Conduct -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etConduct"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Conduct / Character (e.g. Good / उत्तम)"
                        android:text="Good / उत्तम"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Date of Issue & Remarks -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginBottom="6dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDateOfIssue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Date of Issue (e.g. 01/04/2026)"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRemarks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Remarks / Special Note"
                            android:textSize="12sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. ACTION BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnPreviewTc"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="PREVIEW TC"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="#2563EB"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnSaveTc"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="SAVE TC"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="#059669" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPrintTc"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="PRINT"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="#475569"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnPdfTc"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="PDF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="#DC2626"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btnShareTc"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="SHARE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:backgroundTint="#0D9488" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
