<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="#F8FAFC"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:strokeWidth="1dp"
    app:strokeColor="#CBD5E1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- TOP ROW: PHOTO + SR NO BELOW PHOTO (LEFT), NAME (CENTER), CLASS, CASTE, GENDER & SR NUMBER (RIGHT) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- LEFT: PHOTO & SR NO BELOW PHOTO -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageView
                    android:id="@+id/ivStudentPhoto"
                    android:layout_width="70dp"
                    android:layout_height="80dp"
                    android:scaleType="centerCrop"
                    android:background="#E2E8F0"
                    android:contentDescription="Student Photo"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- SR NO BADGE DIRECTLY BELOW PHOTO IN DARK PINK #C2185B -->
                <TextView
                    android:id="@+id/tvSrNoBelowPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sr No: 1"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#C2185B"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

            <!-- STUDENT NAME (MAIN BOLD STUDENT NAME IN BLUE COLOUR #1565C0) -->
            <TextView
                android:id="@+id/tvStudentName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:textColor="#1565C0"
                android:textAllCaps="true"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp" />

            <!-- RIGHT COLUMN: CLASS, CASTE, GENDER, SR NUMBER VALUE WITH SPACING -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <!-- CLASS TAB -->
                <TextView
                    android:id="@+id/tvClassTab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#1976D2"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:layout_marginBottom="4dp" />

                <!-- CASTE TAB -->
                <TextView
                    android:id="@+id/tvCategoryTab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#4E342E"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:layout_marginBottom="4dp" />

                <!-- GENDER TAB -->
                <TextView
                    android:id="@+id/tvGenderTab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Male"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:layout_marginBottom="4dp" />

                <!-- SR NUMBER VALUE ONLY (ROSEWOOD #5A0006) -->
                <TextView
                    android:id="@+id/tvSrNumberVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1025"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="#5A0006"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- DETAILS SECTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp">

            <!-- Row 1: Adm Date & DOB WITH CALL BUTTON ANCHORED ON RIGHT SIDE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="2dp">

                <TextView
                    android:id="@+id/tvAdmDob"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#000000"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-condensed"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnCallStudent"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="📞 Call"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#2E7D32"
                    android:paddingHorizontal="8dp"
                    app:strokeColor="#2E7D32"
                    app:strokeWidth="1dp" />

            </LinearLayout>

            <!-- Row 2: SR Number & C/o (PLACED BELOW ADM DATE & DOB ROW) -->
            <TextView
                android:id="@+id/tvSrInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginBottom="2dp" />

            <!-- Row 3: ADR & UID -->
            <TextView
                android:id="@+id/tvAdrUid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginBottom="2dp" />

            <!-- Row 4: PEN & APR -->
            <TextView
                android:id="@+id/tvPenApr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginBottom="2dp" />

            <!-- Row 5: Fa_N & Fa_A -->
            <TextView
                android:id="@+id/tvFaInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginBottom="2dp" />

            <!-- Row 6: M_N & M_A (BEFORE MOBILE) -->
            <TextView
                android:id="@+id/tvMoInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginBottom="2dp" />

            <!-- Row 7: Mob & Adrs -->
            <TextView
                android:id="@+id/tvMobInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#000000"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-condensed"
                android:layout_marginBottom="2dp" />

        </LinearLayout>

        <!-- HEALTH DETAILS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#FFF8E1"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HEALTH DETAILS"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#F57F17" />

                <TextView
                    android:id="@+id/tvHealthDetailsContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="2dp" />

                <Button
                    android:id="@+id/btnViewHistory"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View History"
                    android:textSize="11sp"
                    android:visibility="gone"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- BANK DETAILS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#EFEBE9"
            app:cardCornerRadius="8dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BANK DETAILS"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#4E342E" />

                <TextView
                    android:id="@+id/tvBankDetailsContent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ACTIONS (ONLY ONE PREVIEW PROFILE BUTTON) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnCardPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Preview Profile"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="#1565C0" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
