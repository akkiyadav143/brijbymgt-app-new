<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#CBD5E1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical">

        <!-- Sr No -->
        <TextView
            android:id="@+id/tvSrNo"
            android:layout_width="28dp"
            android:layout_height="wrap_content"
            android:text="1."
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#64748B"
            android:gravity="center"
            android:layout_marginEnd="4dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMarkStudentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="#1E293B" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMarkSrNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SR: 101"
                    android:textSize="10.5sp"
                    android:textColor="#64748B"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvRowMarksInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Max: 10 | Pass: 3"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="#0D47A1" />

            </LinearLayout>

        </LinearLayout>

        <CheckBox
            android:id="@+id/cbIsAbsent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ab"
            android:textSize="11sp"
            android:textColor="#DC2626"
            android:layout_marginEnd="6dp" />

        <EditText
            android:id="@+id/etObtainedMarks"
            android:layout_width="65dp"
            android:layout_height="38dp"
            android:hint="Marks"
            android:textSize="12sp"
            android:inputType="numberDecimal"
            android:gravity="center"
            android:background="@android:drawable/editbox_background_normal"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/tvSaveStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#16A34A"
            android:visibility="gone"
            android:gravity="center" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
