<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="8dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvResultName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rahul Kumar"
            android:textColor="#0F172A"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvResultSr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SR No: 125"
                android:textColor="#475569"
                android:textSize="12sp"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvResultClass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Class: 8"
                android:textColor="#475569"
                android:textSize="12sp"
                android:layout_marginEnd="12dp" />

            <TextView
                android:id="@+id/tvResultFather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Father: Suresh Kumar"
                android:textColor="#475569"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
