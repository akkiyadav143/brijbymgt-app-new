<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:padding="12dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER BANNER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SELECTED EXPORT (STUDENT &amp; FIELD SELECTION)"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#1E3A8A"
            android:padding="12dp"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- 1. STUDENT SELECTION CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#CBD5E1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥 1. SELECT STUDENTS"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <EditText
                        android:id="@+id/etExpSearchStudent"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@android:drawable/editbox_background"
                        android:hint="Search student name, SR..."
                        android:textSize="12sp"
                        android:paddingHorizontal="8dp"
                        android:layout_marginEnd="6dp" />

                    <Spinner
                        android:id="@+id/spinnerExpClassFilter"
                        android:layout_width="120dp"
                        android:layout_height="40dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btnExpSelectAll"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Select All"
                        android:textSize="10sp"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnExpUnselectAll"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Unselect All"
                        android:textSize="10sp"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvExpSelectedCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Selected: 0 Students"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#0D47A1" />

                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvExpStudentSelection"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="8dp"
                    android:background="#F8FAFC"
                    android:padding="4dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 2. FIELD SELECTION CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#CBD5E1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⚙️ 2. SELECT EXPORT FIELDS"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#E65100" />

                    <Button
                        android:id="@+id/btnSelectAllFields"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Select All"
                        android:textSize="10sp"
                        android:paddingHorizontal="6dp"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnClearAllFields"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Clear All"
                        android:textSize="10sp"
                        android:paddingHorizontal="6dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvSelectedFieldsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selected Fields: 31 / 31"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:textColor="#E65100"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="6dp" />

                <GridLayout
                    android:id="@+id/gridFieldsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- 3. FORMAT & EXPORT BUTTON CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#CBD5E1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💾 3. EXPORT FORMAT &amp; GENERATE"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#0D47A1" />

                <RadioGroup
                    android:id="@+id/rgCustomFormat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/rbCustomFormatCsv"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CSV"
                        android:textSize="12sp"
                        android:layout_marginEnd="12dp" />

                    <RadioButton
                        android:id="@+id/rbCustomFormatExcel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Excel (.xlsx)"
                        android:checked="true"
                        android:textSize="12sp"
                        android:layout_marginEnd="12dp" />

                    <RadioButton
                        android:id="@+id/rbCustomFormatPdf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PDF"
                        android:textSize="12sp" />

                </RadioGroup>

                <Button
                    android:id="@+id/btnCustomExportSubmit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PROCEED TO EXPORT"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    app:backgroundTint="#0D47A1" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
