<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E3A8A"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CREATE NEW EXAM"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:strokeWidth="1dp"
            app:strokeColor="#CBD5E1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Exam Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Exam Name / Title *"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etExamName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="e.g. Half Yearly Examination 2024-25"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:background="@android:drawable/editbox_background_normal"
                    android:paddingHorizontal="12dp"
                    android:layout_marginBottom="12dp" />

                <!-- Academic Session -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Academic Session *"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/etAcademicSession"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="2026-2027"
                    android:textSize="14sp"
                    android:inputType="text"
                    android:background="@android:drawable/editbox_background_normal"
                    android:paddingHorizontal="12dp"
                    android:layout_marginBottom="12dp" />

                <!-- Exam Type -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Exam Type *"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerExamType"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:layout_marginBottom="12dp" />

                <!-- Class Name -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Target Class *"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1E293B"
                    android:layout_marginBottom="4dp" />

                <Spinner
                    android:id="@+id/spinnerClassName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:drawable/btn_dropdown"
                    android:layout_marginBottom="16dp" />

                <!-- ASSESSMENT STRUCTURE PRESET INFO -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="#F8FAFC"
                    app:cardCornerRadius="8dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#CBD5E1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📋 Exam-wide &amp; Subject-wise पूर्णांक संरचना:"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#0D47A1"
                            android:layout_marginBottom="6dp" />

                        <!-- EXAM-WIDE TABLE -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="परीक्षा Exam-wide पूर्णांक:"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#334155"
                            android:layout_marginBottom="4dp" />

                        <TableLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#000000"
                            android:padding="1dp"
                            android:layout_marginBottom="8dp">

                            <TableRow android:background="#E2E8F0" android:padding="3dp">
                                <TextView android:text="परीक्षा (Exam)" android:textStyle="bold" android:textSize="11sp" android:padding="4dp" android:textColor="#0F172A" />
                                <TextView android:text="Exam-wide पूर्णांक" android:textStyle="bold" android:textSize="11sp" android:gravity="end" android:padding="4dp" android:textColor="#0F172A" />
                            </TableRow>
                            <TableRow android:background="#FFFFFF" android:padding="3dp">
                                <TextView android:text="त्रैमासिक" android:textSize="11sp" android:padding="4dp" android:textColor="#0F172A" />
                                <TextView android:text="10" android:textSize="11sp" android:textStyle="bold" android:gravity="end" android:padding="4dp" android:textColor="#1D4ED8" />
                            </TableRow>
                            <TableRow android:background="#F8FAFC" android:padding="3dp">
                                <TextView android:text="अर्धवार्षिक" android:textSize="11sp" android:padding="4dp" android:textColor="#0F172A" />
                                <TextView android:text="30" android:textSize="11sp" android:textStyle="bold" android:gravity="end" android:padding="4dp" android:textColor="#1D4ED8" />
                            </TableRow>
                            <TableRow android:background="#FFFFFF" android:padding="3dp">
                                <TextView android:text="त्रैमासिक-II" android:textSize="11sp" android:padding="4dp" android:textColor="#0F172A" />
                                <TextView android:text="10" android:textSize="11sp" android:textStyle="bold" android:gravity="end" android:padding="4dp" android:textColor="#1D4ED8" />
                            </TableRow>
                            <TableRow android:background="#F8FAFC" android:padding="3dp">
                                <TextView android:text="वार्षिक" android:textSize="11sp" android:padding="4dp" android:textColor="#0F172A" />
                                <TextView android:text="50" android:textSize="11sp" android:textStyle="bold" android:gravity="end" android:padding="4dp" android:textColor="#1D4ED8" />
                            </TableRow>
                        </TableLayout>

                        <!-- SUBJECT-WISE TABLE -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="विषय-वार संरचना (Subject-wise):"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#334155"
                            android:layout_marginBottom="4dp" />

                        <TableLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#000000"
                            android:padding="1dp">

                            <TableRow android:background="#E2E8F0" android:padding="3dp">
                                <TextView android:text="विषय" android:textStyle="bold" android:textSize="11sp" android:padding="4dp" android:textColor="#0F172A" />
                                <TextView android:text="त्रैमासिक" android:textStyle="bold" android:textSize="11sp" android:gravity="center" android:padding="4dp" android:textColor="#0F172A" />
                                <TextView android:text="अर्धवार्षिक" android:textStyle="bold" android:textSize="11sp" android:gravity="center" android:padding="4dp" android:textColor="#0F172A" />
                                <TextView android:text="त्रैमासिक-II" android:textStyle="bold" android:textSize="11sp" android:gravity="center" android:padding="4dp" android:textColor="#0F172A" />
                                <TextView android:text="वार्षिक" android:textStyle="bold" android:textSize="11sp" android:gravity="center" android:padding="4dp" android:textColor="#0F172A" />
                            </TableRow>

                            <TableRow android:background="#FFFFFF" android:padding="3dp">
                                <TextView android:text="हिंदी" android:textSize="11sp" android:padding="4dp" android:textColor="#0F172A" />
                                <TextView android:text="10" android:textSize="11sp" android:gravity="center" android:padding="4dp" android:textColor="#0F172A" />
                                <TextView android:text="30" android:textSize="11sp" android:gravity="center" android:padding="4dp" android:textColor="#0F172A" />
                                <TextView android:text="10" android:textSize="11sp" android:gravity="center" android:padding="4dp" android:textColor="#0F172A" />
                                <TextView android:text="50" android:textSize="11sp" android:gravity="center" android:padding="4dp" android:textColor="#0F172A" />
                            </TableRow>

                            <TableRow android:background="#F8FAFC" android:padding="3dp">
                                <TextView android:text="अंग्रेजी" android:textSize="11sp" android:padding="4dp" android:textColor="#0F172A" />
                                <TextView android:text="10" android:textSize="11sp" android:gravity="center" android:padding="4dp" android:textColor="#0F172A" />
                                <TextView android:text="30" android:textSize="11sp" android:gravity="center" android:padding="4dp" android:textColor="#0F172A" />
                                <TextView android:text="10" android:textSize="11sp" android:gravity="center" android:padding="4dp" android:textColor="#0F172A" />
                                <TextView android:text="50" android:textSize="11sp" android:gravity="center" android:padding="4dp" android:textColor="#0F172A" />
                            </TableRow>

                            <TableRow android:background="#FFFFFF" android:padding="3dp">
                                <TextView android:text="गणित" android:textSize="11sp" android:padding="4dp" android:textColor="#0F172A" />
                                <TextView android:text="10" android:textSize="11sp" android:gravity="center" android:padding="4dp" android:textColor="#0F172A" />
                                <TextView android:text="30" android:textSize="11sp" android:gravity="center" android:padding="4dp" android:textColor="#0F172A" />
                                <TextView android:text="10" android:textSize="11sp" android:gravity="center" android:padding="4dp" android:textColor="#0F172A" />
                                <TextView android:text="50" android:textSize="11sp" android:gravity="center" android:padding="4dp" android:textColor="#0F172A" />
                            </TableRow>

                            <TableRow android:background="#F8FAFC" android:padding="3dp">
                                <TextView android:text="+ अन्य विषय" android:textStyle="bold" android:textSize="11sp" android:padding="4dp" android:textColor="#E65100" />
                                <TextView android:text="स्वयं जोड़ें" android:textSize="10sp" android:gravity="center" android:padding="4dp" android:textColor="#64748B" />
                                <TextView android:text="स्वयं जोड़ें" android:textSize="10sp" android:gravity="center" android:padding="4dp" android:textColor="#64748B" />
                                <TextView android:text="स्वयं जोड़ें" android:textSize="10sp" android:gravity="center" android:padding="4dp" android:textColor="#64748B" />
                                <TextView android:text="स्वयं जोड़ें" android:textSize="10sp" android:gravity="center" android:padding="4dp" android:textColor="#64748B" />
                            </TableRow>

                        </TableLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Submit Button -->
                <Button
                    android:id="@+id/btnSubmitCreateExam"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="🚀 Create Exam &amp; Sync Students"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#1565C0" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
