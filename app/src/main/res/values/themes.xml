<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="DarkBlueHintTextAppearance" parent="TextAppearance.Design.Hint">
        <item name="android:textColor">#0D47A1</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.brijbymgt.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">#212529</item>
        <item name="android:textColorHint">#212529</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="DarkBlueHintTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="hintTextColor">#0D47A1</item>
        <item name="android:textColorHint">#212529</item>
        <item name="boxStrokeColor">#0D47A1</item>
        <item name="hintTextAppearance">@style/DarkBlueHintTextAppearance</item>
        <item name="editTextStyle">@style/Widget.brijbymgt.TextInputEditText</item>
    </style>

    <!-- Base application theme. -->
    <style name="Base.Theme.brijbymgt" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">#0D47A1</item>
        <item name="colorSecondary">#0D47A1</item>
        <item name="colorTertiary">#0D47A1</item>
        <item name="textInputStyle">@style/DarkBlueHintTextInputLayout</item>
    </style>

    <style name="Theme.brijbymgt" parent="Base.Theme.brijbymgt" />
</resources>
